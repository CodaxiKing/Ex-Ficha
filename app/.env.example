# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > API). A chave é a publicável (anon/publishable), nunca a service_role.
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sua-chave-publicavel

# Assinatura premium (RevenueCat: Project settings > API keys, as chaves públicas do app).
# Crie no RevenueCat o entitlement "premium" e uma offering com pacotes Anual e Mensal.
EXPO_PUBLIC_REVENUECAT_IOS=appl_sua-chave-publica
EXPO_PUBLIC_REVENUECAT_ANDROID=goog_sua-chave-publica
