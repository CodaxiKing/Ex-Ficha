{
  "expo": {
    "name": "Ex-Ficha",
    "slug": "ex-ficha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "exficha",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.exficha"
    },
    "android": {
      "package": "app.exficha",
      "adaptiveIcon": {
        "backgroundColor": "#0b0909",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-mono.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0909",
          "image": "./assets/images/logo-mark-hd.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#d0121a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Ex-Ficha usa suas fotos só para o antes e depois. Elas ficam no seu aparelho.",
          "cameraPermission": "O Ex-Ficha usa a câmera para a foto da semana. Ela fica no seu aparelho."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0b0909"
  }
}